API_PORT=4000
CORS_ORIGIN=http://localhost:5173
# Tạo key tại https://maps.vietmap.vn/ và giữ key phía máy chủ.
# Không đặt key trong apps/web hoặc biến VITE_*.
VIETMAP_API_KEY=
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# File đồ thị OpenStreetMap cho Dijkstra/A* (tạo bằng `npm run osm:import` ở thư mục gốc).
OSM_GRAPH_FILE=data/osm/hcmc-center.json
