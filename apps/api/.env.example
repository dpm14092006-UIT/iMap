API_PORT=4000
CORS_ORIGIN=http://localhost:5173
# Tạo key tại https://maps.vietmap.vn/ và giữ key phía máy chủ.
# Không đặt key trong apps/web hoặc biến VITE_*.
VIETMAP_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRAFFIC_AI_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Thông báo đẩy cho xe đang đi trên tuyến có sự cố (tùy chọn; để trống thì chỉ cảnh báo trong app).
# Khóa bí mật Supabase (sb_secret_… hoặc service_role) — chỉ đặt ở API, KHÔNG bao giờ đặt ở web.
SUPABASE_SECRET_KEY=
# Tạo cặp khóa: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Trợ lý địa điểm: off = bộ lọc từ khóa, ollama = model local, gemini = API riêng.
# Chọn model đã cài local hoặc có free quota thực tế. Không tự chuyển sang model trả phí.
STOP_AI_PROVIDER=off
# STOP_AI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Route comparison always supports presets. Enable AI for signed-in requests after migration 0008.
ROUTE_EXPLANATION_PROVIDER=off
ROUTE_EXPLANATION_MODEL=
# Optional separate signing key (32+ chars); falls back to the backend VietMap key.
ROUTE_COMPARISON_SECRET=

# File đồ thị OpenStreetMap cho Dijkstra/A* (tạo bằng `npm run osm:import` ở thư mục gốc).
OSM_GRAPH_FILE=data/osm/hcmc-center.json

# Giới hạn lượt/phút/IP cho endpoint gọi VietMap tính phí (bộ đếm trong RAM, theo từng instance).
RATE_LIMIT_POI_PER_MIN=20
RATE_LIMIT_ROUTES_PER_MIN=30
RATE_LIMIT_PLACES_PER_MIN=60
RATE_LIMIT_OPTIMIZE_PER_MIN=10
# Số proxy tin cậy phía trước API (Vercel/nginx = 1) để lấy đúng IP máy khách; 0 = không tin X-Forwarded-For.
TRUST_PROXY_HOPS=0
