API_PORT=4000
CORS_ORIGIN=http://localhost:5173
# Tạo key tại https://maps.vietmap.vn/ và giữ key phía máy chủ.
# Không đặt key trong apps/web hoặc biến VITE_*.
VIETMAP_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRAFFIC_AI_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Trợ lý địa điểm: off = bộ lọc từ khóa, ollama = model local, gemini = API riêng.
# Chọn model đã cài local hoặc có free quota thực tế. Không tự chuyển sang model trả phí.
STOP_AI_PROVIDER=off
# STOP_AI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Free-tier voice API (server only). Keep Cloudflare on Workers Free for quota hard stop.
VOICE_STT_PROVIDER=off
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# File đồ thị OpenStreetMap cho Dijkstra/A* (tạo bằng `npm run osm:import` ở thư mục gốc).
OSM_GRAPH_FILE=data/osm/hcmc-center.json
